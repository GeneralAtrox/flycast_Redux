{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flycast.example/research/flycast-research-ghidra-export-v1.schema.json",
  "title": "Flycast Research Ghidra Export v1",
  "description": "Structural pre-flight schema. Canonical ordering, aggregate counts, address parity, range containment, non-overlap, and identity joins are enforced by flycast-research-validate-ghidra-export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "export_id",
    "evidence_class",
    "producer",
    "program",
    "memory_blocks",
    "functions",
    "symbols",
    "data_types",
    "counts"
  ],
  "properties": {
    "schema": { "const": "flycast-research-ghidra-export" },
    "schema_version": { "const": 1 },
    "export_id": { "$ref": "#/$defs/id" },
    "evidence_class": { "const": "static-analysis" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "exporter_id", "exporter_sha256"],
      "properties": {
        "name": { "const": "Ghidra" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "exporter_id": { "const": "flycast-ghidra-export-v1" },
        "exporter_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "executable_sha256",
        "executable_size",
        "language_id",
        "compiler_spec_id",
        "endian",
        "address_size",
        "address_space",
        "ghidra_image_base",
        "image_base",
        "image_base_source",
        "minimum_address",
        "maximum_address"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "executable_size": { "type": "integer", "minimum": 1 },
        "language_id": { "const": "SuperH4:LE:32:default" },
        "compiler_spec_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "endian": { "const": "little" },
        "address_size": { "const": 32 },
        "address_space": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ghidra_image_base": { "$ref": "#/$defs/address" },
        "image_base": { "$ref": "#/$defs/address" },
        "image_base_source": {
          "enum": ["ghidra-program", "minimum-initialized-executable-block"]
        },
        "minimum_address": { "$ref": "#/$defs/address" },
        "maximum_address": { "$ref": "#/$defs/address" }
      }
    },
    "memory_blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/memory_block" }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250000,
      "items": { "$ref": "#/$defs/function" }
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/symbol" }
    },
    "data_types": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/data_type" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_blocks", "functions", "symbols", "data_types"],
      "properties": {
        "memory_blocks": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "functions": { "type": "integer", "minimum": 1, "maximum": 250000 },
        "symbols": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "data_types": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{8}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "memory_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "start_address", "length", "read", "write", "execute", "initialized"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "start_address": { "$ref": "#/$defs/address" },
        "length": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
        "read": { "type": "boolean" },
        "write": { "type": "boolean" },
        "execute": { "type": "boolean" },
        "initialized": { "type": "boolean" }
      }
    },
    "body_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_address", "length"],
      "properties": {
        "start_address": { "$ref": "#/$defs/address" },
        "length": { "type": "integer", "minimum": 2, "maximum": 4294967296, "multipleOf": 2 }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_address",
        "name",
        "namespace",
        "calling_convention",
        "return_type",
        "parameter_types",
        "body_ranges",
        "thunk",
        "no_return"
      ],
      "properties": {
        "entry_address": { "$ref": "#/$defs/address" },
        "name": { "$ref": "#/$defs/text" },
        "namespace": { "type": "string", "maxLength": 4096 },
        "calling_convention": { "type": "string", "minLength": 1, "maxLength": 256 },
        "return_type": { "$ref": "#/$defs/text" },
        "parameter_types": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/text" }
        },
        "body_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000000,
          "items": { "$ref": "#/$defs/body_range" }
        },
        "thunk": { "type": "boolean" },
        "no_return": { "type": "boolean" }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "name", "namespace", "kind", "source", "primary"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "name": { "$ref": "#/$defs/text" },
        "namespace": { "type": "string", "maxLength": 4096 },
        "kind": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/id" },
        "primary": { "type": "boolean" }
      }
    },
    "data_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "length", "dynamic", "definition"],
      "properties": {
        "path": { "$ref": "#/$defs/text" },
        "kind": { "$ref": "#/$defs/id" },
        "length": { "type": "integer", "minimum": 0, "maximum": 4294967296 },
        "dynamic": { "type": "boolean" },
        "definition": { "type": "string", "minLength": 1, "maxLength": 65536 }
      }
    }
  }
}
