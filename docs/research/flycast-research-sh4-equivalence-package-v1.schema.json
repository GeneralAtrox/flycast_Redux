{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flycast-research-sh4-equivalence-package-v1.schema.json",
  "title": "Flycast SH-4 equivalence package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "package_id", "locked_entries"],
  "properties": {
    "schema": { "const": "flycast-research-sh4-equivalence-package" },
    "schema_version": { "const": 1 },
    "package_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "locked_entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/blob" }
    }
  },
  "$defs": {
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9._/-]+$"
        },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
