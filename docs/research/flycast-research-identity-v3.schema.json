{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flycast-redux.invalid/schemas/flycast-research-identity-v3.schema.json",
  "title": "Flycast State-started Maple Record Identity v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "initial_state",
    "media",
    "firmware",
    "persistent_devices",
    "emulator",
    "configuration"
  ],
  "properties": {
    "schema": { "const": "flycast-research-identity" },
    "schema_version": { "const": 3 },
    "initial_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "slot", "blob"],
      "properties": {
        "kind": { "const": "savestate" },
        "slot": { "type": "integer", "minimum": 0, "maximum": 9 },
        "blob": { "$ref": "#/$defs/nonempty_blob" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "source", "tracks", "ip_bin", "boot_executable"],
      "properties": {
        "kind": { "const": "gdi" },
        "source": { "$ref": "#/$defs/blob" },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/blob" },
              {
                "type": "object",
                "required": ["track", "start_fad", "sector_size", "offset"],
                "properties": {
                  "track": { "type": "integer", "minimum": 1, "maximum": 99 },
                  "start_fad": { "type": "integer", "minimum": 0 },
                  "sector_size": { "enum": [2048, 2336, 2352, 2448] },
                  "offset": { "type": "integer", "minimum": 0 }
                }
              }
            ]
          }
        },
        "ip_bin": { "$ref": "#/$defs/blob" },
        "boot_executable": {
          "allOf": [
            { "$ref": "#/$defs/blob" },
            {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "load_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" }
              }
            }
          ]
        }
      }
    },
    "firmware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "flash_initial"],
      "properties": {
        "mode": { "enum": ["real", "hle"] },
        "bios": {
          "oneOf": [
            { "$ref": "#/$defs/blob" },
            { "type": "null" }
          ]
        },
        "hle_identity": { "type": ["string", "null"], "minLength": 1 },
        "flash_initial": { "$ref": "#/$defs/blob" }
      }
    },
    "persistent_devices": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/blob" },
          {
            "type": "object",
            "required": ["kind", "bus", "port"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "bus": { "type": "integer", "minimum": 0, "maximum": 3 },
              "port": { "type": "integer", "minimum": 0, "maximum": 5 }
            }
          }
        ]
      }
    },
    "emulator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "executable"],
      "properties": {
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "executable": { "$ref": "#/$defs/blob" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "sha256"],
      "properties": {
        "values": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "cpu_backend",
            "dynarec_observation",
            "dreamcast_rtc_seed",
            "threaded_rendering",
            "autoload_state",
            "savestate_slot",
            "autosave_state",
            "ggpo",
            "maple_dma_checkpoint"
          ],
          "properties": {
            "cpu_backend": { "enum": ["interpreter", "dynarec"] },
            "dynarec_observation": { "const": false },
            "dynarec_profile": { "type": "boolean" },
            "dreamcast_rtc_seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "threaded_rendering": { "const": false },
            "autoload_state": { "const": true },
            "savestate_slot": { "type": "integer", "minimum": 0, "maximum": 9 },
            "autosave_state": { "const": false },
            "ggpo": { "const": false },
            "maple_dma_checkpoint": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "flycast_transient": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "maxItems": 128
            }
          }
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "static_analysis": {
      "type": "object",
      "additionalProperties": true,
      "required": ["program_sha256", "image_base", "export_sha256"],
      "properties": {
        "program_sha256": { "$ref": "#/$defs/sha256" },
        "image_base": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
        "export_sha256": { "$ref": "#/$defs/sha256" },
        "hook_manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "configuration": {
            "properties": {
              "values": {
                "properties": { "cpu_backend": { "const": "dynarec" } },
                "required": ["cpu_backend"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "configuration": {
            "properties": {
              "values": {
                "required": ["dynarec_profile"],
                "properties": { "dynarec_profile": { "const": true } }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "firmware": {
            "properties": { "mode": { "const": "real" } },
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": {
          "firmware": {
            "required": ["bios"],
            "properties": { "bios": { "$ref": "#/$defs/blob" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "firmware": {
            "properties": { "mode": { "const": "hle" } },
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": { "firmware": { "required": ["hle_identity"] } }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "blob": {
      "type": "object",
      "required": ["size", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nonempty_blob": {
      "allOf": [
        { "$ref": "#/$defs/blob" },
        {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "size": { "type": "integer", "minimum": 1, "maximum": 134217728 }
          }
        }
      ]
    }
  }
}
