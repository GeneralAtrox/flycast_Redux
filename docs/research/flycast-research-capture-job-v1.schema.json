{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flycast-redux.invalid/schemas/flycast-research-capture-job-v1.schema.json",
  "title": "Flycast Research Capture Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "driver",
    "identity_manifest",
    "emulator",
    "validator",
    "capture_validator",
    "output",
    "limits"
  ],
  "properties": {
    "schema": { "const": "flycast-research-capture-job" },
    "schema_version": { "const": 1 },
    "driver": { "$ref": "#/$defs/blob" },
    "identity_manifest": { "$ref": "#/$defs/blob" },
    "emulator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_executable",
        "interactive",
        "arguments_prefix",
        "authenticated_inputs",
        "runtime_files"
      ],
      "properties": {
        "stage_executable": { "const": true },
        "interactive": { "type": "boolean" },
        "arguments_prefix": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 64
        },
        "authenticated_inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/blob" },
          "maxItems": 128
        },
        "runtime_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtime_file" },
          "maxItems": 128
        }
      }
    },
    "validator": { "$ref": "#/$defs/process_tool" },
    "capture_validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable"],
      "properties": {
        "executable": { "$ref": "#/$defs/blob" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_directory", "artifact_name"],
      "properties": {
        "accepted_directory": { "type": "string", "minLength": 1 },
        "artifact_name": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.fcmr$"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_max_bytes",
        "emulator_timeout_seconds",
        "validator_timeout_seconds",
        "stability_interval_ms"
      ],
      "properties": {
        "trace_max_bytes": {
          "type": "integer",
          "minimum": 160,
          "maximum": 1099511627776
        },
        "emulator_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "validator_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "stability_interval_ms": {
          "type": "integer",
          "minimum": 50,
          "maximum": 5000
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "destination"],
      "properties": {
        "source": { "$ref": "#/$defs/blob" },
        "destination": { "type": "string", "minLength": 1 }
      }
    },
    "process_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments_prefix", "authenticated_inputs"],
      "properties": {
        "executable": { "$ref": "#/$defs/blob" },
        "arguments_prefix": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 64
        },
        "authenticated_inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/blob" },
          "maxItems": 128
        }
      }
    }
  }
}
