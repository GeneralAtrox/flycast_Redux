{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flycast-redux.invalid/schemas/flycast-research-pvr-ta-package-job-v1.schema.json",
  "title": "Flycast PowerVR TA Package Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "package_id", "output",
    "base_equivalence_package", "identity", "maple_replay", "pvr_manifest",
    "artifact", "static_analysis", "publisher", "artifact_validator",
    "package_validator", "limits", "metadata"
  ],
  "properties": {
    "schema": { "const": "flycast-research-pvr-ta-package-job" },
    "schema_version": { "const": 1 },
    "package_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted_directory"],
      "properties": { "accepted_directory": { "$ref": "#/$defs/path" } }
    },
    "base_equivalence_package": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted_directory", "backend"],
      "properties": {
        "accepted_directory": { "$ref": "#/$defs/path" },
        "backend": { "enum": ["interpreter", "dynarec"] }
      }
    },
    "identity": { "$ref": "#/$defs/blob" },
    "maple_replay": { "$ref": "#/$defs/blob" },
    "pvr_manifest": { "$ref": "#/$defs/blob" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate", "maximum_bytes", "maximum_events"],
      "properties": {
        "candidate": { "$ref": "#/$defs/blob" },
        "maximum_bytes": { "type": "integer", "minimum": 272, "maximum": 536870912 },
        "maximum_events": { "type": "integer", "minimum": 1, "maximum": 10000000 }
      }
    },
    "static_analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["export", "program"],
      "properties": {
        "export": { "$ref": "#/$defs/blob" },
        "program": { "$ref": "#/$defs/blob" }
      }
    },
    "publisher": {
      "type": "object", "additionalProperties": false, "required": ["script"],
      "properties": { "script": { "$ref": "#/$defs/blob" } }
    },
    "artifact_validator": {
      "type": "object", "additionalProperties": false, "required": ["executable"],
      "properties": { "executable": { "$ref": "#/$defs/blob" } }
    },
    "package_validator": {
      "type": "object", "additionalProperties": false, "required": ["executable"],
      "properties": { "executable": { "$ref": "#/$defs/blob" } }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["validator_timeout_seconds"],
      "properties": { "validator_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 } }
    },
    "metadata": { "type": "object", "maxProperties": 64 }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "blob": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
