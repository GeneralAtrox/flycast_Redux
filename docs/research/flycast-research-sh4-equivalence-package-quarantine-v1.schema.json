{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flycast-research-sh4-equivalence-package-quarantine-v1.schema.json",
  "title": "Flycast SH-4 equivalence package quarantine record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "package_id", "accepted_directory", "failure"
  ],
  "properties": {
    "schema": { "const": "flycast-research-sh4-equivalence-package-quarantine" },
    "schema_version": { "const": 1 },
    "package_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "accepted_directory": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "failure": { "type": "string", "minLength": 1, "maxLength": 16384 }
  }
}
