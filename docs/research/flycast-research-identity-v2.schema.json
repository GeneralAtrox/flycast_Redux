{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flycast-redux.invalid/schemas/flycast-research-identity-v2.schema.json",
  "title": "Flycast Research Identity v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "media",
    "firmware",
    "persistent_devices",
    "emulator",
    "configuration",
    "equivalence"
  ],
  "properties": {
    "schema": { "const": "flycast-research-identity" },
    "schema_version": { "const": 2 },
    "initial_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "slot", "blob"],
      "properties": {
        "kind": { "const": "savestate" },
        "slot": { "type": "integer", "minimum": 0, "maximum": 9 },
        "blob": { "$ref": "#/$defs/blob" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "source", "ip_bin", "boot_executable"],
      "properties": {
        "kind": {
          "enum": ["gdi", "cue", "chd", "cdi", "elf", "bios", "arcade"]
        },
        "source": { "$ref": "#/$defs/blob" },
        "tracks": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/blob" },
              {
                "type": "object",
                "required": ["track", "start_fad", "sector_size", "offset"],
                "properties": {
                  "track": { "type": "integer", "minimum": 1, "maximum": 99 },
                  "start_fad": { "type": "integer", "minimum": 0 },
                  "sector_size": { "enum": [2048, 2336, 2352, 2448] },
                  "offset": { "type": "integer", "minimum": 0 }
                }
              }
            ]
          }
        },
        "ip_bin": { "$ref": "#/$defs/blob" },
        "boot_executable": {
          "allOf": [
            { "$ref": "#/$defs/blob" },
            {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "load_address": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{8}$"
                }
              }
            }
          ]
        }
      }
    },
    "firmware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "flash_initial"],
      "properties": {
        "mode": { "enum": ["real", "hle"] },
        "bios": {
          "oneOf": [
            { "$ref": "#/$defs/blob" },
            { "type": "null" }
          ]
        },
        "hle_identity": { "type": ["string", "null"], "minLength": 1 },
        "flash_initial": { "$ref": "#/$defs/blob" }
      }
    },
    "persistent_devices": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/blob" },
          {
            "type": "object",
            "required": ["kind", "bus", "port"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "bus": { "type": "integer", "minimum": 0, "maximum": 3 },
              "port": { "type": "integer", "minimum": 0, "maximum": 5 }
            }
          }
        ]
      }
    },
    "emulator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "executable"],
      "properties": {
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "executable": { "$ref": "#/$defs/blob" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "sha256"],
      "properties": {
        "values": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "cpu_backend",
            "dynarec_observation",
            "dreamcast_rtc_seed",
            "threaded_rendering",
            "autoload_state",
            "autosave_state",
            "ggpo"
          ],
          "properties": {
            "cpu_backend": { "enum": ["interpreter", "dynarec"] },
            "dynarec_observation": { "type": "boolean" },
            "dynarec_profile": { "type": "boolean" },
            "dynarec_replay_diagnostic": { "type": "boolean" },
            "dreamcast_rtc_seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "threaded_rendering": { "const": false },
            "autoload_state": { "type": "boolean" },
            "savestate_slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "autosave_state": { "const": false },
            "ggpo": { "const": false },
            "maple_dma_checkpoint": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "sh4_observation_start_dma": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
              "pvr_ta_start_dma": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000
              },
              "pvr_draw_configuration": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "renderer",
                  "per_strip_sorting",
                  "translucent_polygon_depth_mask",
                  "modifier_volumes",
                  "render_resolution",
                  "emulate_framebuffer",
                  "fix_upscale_bleeding_edge"
                ],
                "properties": {
                  "renderer": { "const": "directx11" },
                  "per_strip_sorting": { "type": "boolean" },
                  "translucent_polygon_depth_mask": { "type": "boolean" },
                  "modifier_volumes": { "type": "boolean" },
                  "render_resolution": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "emulate_framebuffer": { "type": "boolean" },
                  "fix_upscale_bleeding_edge": { "type": "boolean" }
                }
              },
              "aica_configuration": {
                "type": "object",
                "additionalProperties": false,
                "required": ["dsp_enabled", "vmu_sound", "sample_rate", "sample_format", "output_stage"],
                "properties": {
                  "dsp_enabled": { "type": "boolean" },
                  "vmu_sound": { "const": false },
                  "sample_rate": { "const": 44100 },
                  "sample_format": { "const": "signed-pcm16-le-stereo" },
                  "output_stage": { "const": "pre-backend-pre-user-volume" }
                }
              },
            "flycast_transient": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "maxItems": 128
            }
          }
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "static_analysis": {
      "type": "object",
      "additionalProperties": true,
      "required": ["program_sha256", "image_base", "export_sha256"],
      "properties": {
        "program_sha256": { "$ref": "#/$defs/sha256" },
        "image_base": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
        "export_sha256": { "$ref": "#/$defs/sha256" },
        "hook_manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maple_replay_identity_sha256"],
      "properties": {
        "maple_replay_identity_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "configuration": {
            "properties": {
              "values": {
                "properties": { "cpu_backend": { "const": "interpreter" } },
                "required": ["cpu_backend"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "configuration": {
            "properties": {
              "values": {
                "properties": { "dynarec_observation": { "const": false } }
              }
            }
          }
        }
      },
      "else": {}
    },
    {
      "if": {
        "properties": {
          "configuration": {
            "properties": {
              "values": {
                "properties": { "dynarec_profile": { "const": true } },
                "required": ["dynarec_profile"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "configuration": {
            "properties": {
              "values": {
                "properties": {
                  "cpu_backend": { "const": "dynarec" },
                  "dynarec_observation": { "const": false }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "configuration": {
            "properties": {
              "values": {
                "properties": { "dynarec_replay_diagnostic": { "const": true } },
                "required": ["dynarec_replay_diagnostic"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "configuration": {
            "properties": {
              "values": {
                "properties": {
                  "cpu_backend": { "const": "dynarec" },
                  "dynarec_profile": { "const": false }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "media": {
            "properties": { "kind": { "const": "gdi" } },
            "required": ["kind"]
          }
        }
      },
      "then": {
        "properties": {
          "media": {
            "required": ["tracks"],
            "properties": { "tracks": { "minItems": 1 } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "firmware": {
            "properties": { "mode": { "const": "real" } },
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": {
          "firmware": {
            "required": ["bios"],
            "properties": { "bios": { "$ref": "#/$defs/blob" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "firmware": {
            "properties": { "mode": { "const": "hle" } },
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": { "firmware": { "required": ["hle_identity"] } }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "blob": {
      "type": "object",
      "required": ["size", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
