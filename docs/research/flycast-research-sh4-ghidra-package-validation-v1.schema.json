{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flycast-research-sh4-ghidra-package-validation-v1.schema.json",
  "title": "Flycast SH-4/Ghidra package validation receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "package_id", "status", "package_manifest",
    "semantic_join", "semantic_summary", "validator", "locked_entry_count"
  ],
  "properties": {
    "schema": { "const": "flycast-research-sh4-ghidra-package-validation" },
    "schema_version": { "const": 1 },
    "package_id": { "$ref": "#/$defs/uuid" },
    "status": { "const": "accepted" },
    "package_manifest": { "$ref": "#/$defs/blob" },
    "semantic_join": { "$ref": "#/$defs/blob" },
    "semantic_summary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "block_count", "edge_count", "edge_occurrences",
        "authenticated_program_blocks", "function_owned_blocks",
        "static_executable_unassigned_blocks", "runtime_only_blocks"
      ],
      "properties": {
        "block_count": { "$ref": "#/$defs/u64" },
        "edge_count": { "$ref": "#/$defs/u64" },
        "edge_occurrences": { "$ref": "#/$defs/u64" },
        "authenticated_program_blocks": { "$ref": "#/$defs/u64" },
        "function_owned_blocks": { "$ref": "#/$defs/u64" },
        "static_executable_unassigned_blocks": { "$ref": "#/$defs/u64" },
        "runtime_only_blocks": { "$ref": "#/$defs/u64" }
      }
    },
    "validator": { "$ref": "#/$defs/blob" },
    "locked_entry_count": { "type": "integer", "minimum": 1, "maximum": 32 }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "u64": { "type": "integer", "minimum": 0 },
    "blob": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
