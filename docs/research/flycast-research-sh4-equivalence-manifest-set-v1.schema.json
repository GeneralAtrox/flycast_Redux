{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flycast-research-sh4-equivalence-manifest-set-v1.schema.json",
  "title": "Flycast SH-4 equivalence manifest set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "manifests"],
  "properties": {
    "schema": { "const": "flycast-research-sh4-equivalence-manifest-set" },
    "schema_version": { "const": 1 },
    "manifests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "size", "sha256"],
        "properties": {
          "kind": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
