{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flycast-redux.invalid/schemas/flycast-research-pvr-ta-capture-manifest-v1.schema.json",
  "title": "Flycast PowerVR TA Capture Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "manifest_id", "capture", "limits", "static_analysis"],
  "properties": {
    "schema": { "const": "flycast-research-pvr-ta-capture-manifest" },
    "schema_version": { "const": 1 },
    "manifest_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_dma", "render_done_count"],
      "properties": {
        "start_dma": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "render_done_count": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_bytes", "maximum_events"],
      "properties": {
        "maximum_bytes": { "type": "integer", "minimum": 272, "maximum": 536870912 },
        "maximum_events": { "type": "integer", "minimum": 1, "maximum": 10000000 }
      }
    },
    "static_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["export_sha256", "executable_sha256"],
      "properties": {
        "export_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "executable_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
