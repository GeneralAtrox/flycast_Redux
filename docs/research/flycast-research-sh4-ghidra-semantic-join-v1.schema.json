{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flycast.example/research/flycast-research-sh4-ghidra-semantic-join-v1.schema.json",
  "title": "Flycast SH-4/Ghidra semantic join v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "evidence_class", "bindings", "coverage", "functions", "symbol_addresses", "blocks", "edges"],
  "properties": {
    "schema": { "const": "flycast-research-sh4-ghidra-semantic-join" },
    "schema_version": { "const": 1 },
    "evidence_class": { "const": "static-dynamic-join" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_sha256", "replay_sha256", "profile_sha256", "profile_payload_sha256", "configuration_sha256", "ghidra_export_id", "ghidra_export_sha256", "program_sha256", "exporter_script_sha256", "image_base", "program_size"],
      "properties": {
        "identity_sha256": { "$ref": "#/$defs/sha256" },
        "replay_sha256": { "$ref": "#/$defs/sha256" },
        "profile_sha256": { "$ref": "#/$defs/sha256" },
        "profile_payload_sha256": { "$ref": "#/$defs/sha256" },
        "configuration_sha256": { "$ref": "#/$defs/sha256" },
        "ghidra_export_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ghidra_export_sha256": { "$ref": "#/$defs/sha256" },
        "program_sha256": { "$ref": "#/$defs/sha256" },
        "exporter_script_sha256": { "$ref": "#/$defs/sha256" },
        "image_base": { "$ref": "#/$defs/address" },
        "program_size": { "$ref": "#/$defs/u64" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_count", "edge_count", "edge_occurrences", "authenticated_program_blocks", "exact_byte_blocks", "function_owned_blocks", "static_executable_unassigned_blocks", "runtime_only_blocks", "edge_source_classes", "edge_destination_classes", "edge_source_occurrences", "edge_destination_occurrences"],
      "properties": {
        "block_count": { "$ref": "#/$defs/u64" },
        "edge_count": { "$ref": "#/$defs/u64" },
        "edge_occurrences": { "$ref": "#/$defs/u64" },
        "authenticated_program_blocks": { "$ref": "#/$defs/u64" },
        "exact_byte_blocks": { "$ref": "#/$defs/u64" },
        "function_owned_blocks": { "$ref": "#/$defs/u64" },
        "static_executable_unassigned_blocks": { "$ref": "#/$defs/u64" },
        "runtime_only_blocks": { "$ref": "#/$defs/u64" },
        "edge_source_classes": { "$ref": "#/$defs/class_counts" },
        "edge_destination_classes": { "$ref": "#/$defs/class_counts" },
        "edge_source_occurrences": { "$ref": "#/$defs/class_counts" },
        "edge_destination_occurrences": { "$ref": "#/$defs/class_counts" }
      }
    },
    "functions": { "type": "array", "items": { "$ref": "#/$defs/function" } },
    "symbol_addresses": { "type": "array", "items": { "$ref": "#/$defs/symbol_address" } },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  },
  "$defs": {
    "u64": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-f]{8}$" },
    "opcode": { "type": "string", "pattern": "^0x[0-9a-f]{4}$" },
    "mapping_class": { "enum": ["function-entry", "function-interior", "static-executable-unassigned", "authenticated-program-non-executable", "runtime-only"] },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "function_entry"],
      "properties": {
        "class": { "$ref": "#/$defs/mapping_class" },
        "function_entry": { "oneOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_address", "length"],
      "properties": { "start_address": { "$ref": "#/$defs/address" }, "length": { "$ref": "#/$defs/u64" } }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_address", "name", "namespace", "calling_convention", "return_type", "parameter_types", "body_ranges", "thunk", "no_return"],
      "properties": {
        "entry_address": { "$ref": "#/$defs/address" },
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "calling_convention": { "type": "string" },
        "return_type": { "type": "string" },
        "parameter_types": { "type": "array", "items": { "type": "string" } },
        "body_ranges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/range" } },
        "thunk": { "type": "boolean" },
        "no_return": { "type": "boolean" }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace", "kind", "source", "primary"],
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "kind": { "type": "string" },
        "source": { "type": "string" },
        "primary": { "type": "boolean" }
      }
    },
    "symbol_address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "symbols"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "symbols": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/symbol" } }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "opcode", "target", "fallthrough"],
      "properties": {
        "kind": { "enum": ["conditional", "call", "jump", "return"] },
        "source": { "$ref": "#/$defs/address" },
        "opcode": { "$ref": "#/$defs/opcode" },
        "target": { "oneOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] },
        "fallthrough": { "oneOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "virtual_address", "physical_address", "fpu_configuration", "guest_code_size", "guest_cycles", "guest_opcodes", "guest_bytes_sha256", "entered", "completed", "aborted", "total_cycles", "first_entry_tick", "last_exit_tick", "branch", "mapping"],
      "properties": {
        "generation": { "$ref": "#/$defs/u64" },
        "virtual_address": { "$ref": "#/$defs/address" },
        "physical_address": { "$ref": "#/$defs/address" },
        "fpu_configuration": { "$ref": "#/$defs/u64" },
        "guest_code_size": { "$ref": "#/$defs/u64" },
        "guest_cycles": { "$ref": "#/$defs/u64" },
        "guest_opcodes": { "$ref": "#/$defs/u64" },
        "guest_bytes_sha256": { "$ref": "#/$defs/sha256" },
        "entered": { "$ref": "#/$defs/u64" },
        "completed": { "$ref": "#/$defs/u64" },
        "aborted": { "$ref": "#/$defs/u64" },
        "total_cycles": { "$ref": "#/$defs/u64" },
        "first_entry_tick": { "$ref": "#/$defs/u64" },
        "last_exit_tick": { "$ref": "#/$defs/u64" },
        "branch": { "oneOf": [{ "$ref": "#/$defs/branch" }, { "type": "null" }] },
        "mapping": { "$ref": "#/$defs/mapping" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_generation", "source", "destination", "opcode", "kind", "taken", "count", "first_boundary_tick", "last_boundary_tick", "source_mapping", "destination_mapping"],
      "properties": {
        "source_generation": { "$ref": "#/$defs/u64" },
        "source": { "$ref": "#/$defs/address" },
        "destination": { "$ref": "#/$defs/address" },
        "opcode": { "$ref": "#/$defs/opcode" },
        "kind": { "enum": ["conditional", "call", "jump", "return"] },
        "taken": { "type": "boolean" },
        "count": { "$ref": "#/$defs/u64" },
        "first_boundary_tick": { "$ref": "#/$defs/u64" },
        "last_boundary_tick": { "$ref": "#/$defs/u64" },
        "source_mapping": { "$ref": "#/$defs/mapping" },
        "destination_mapping": { "$ref": "#/$defs/mapping" }
      }
    },
    "class_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "function-entry": { "$ref": "#/$defs/u64" },
        "function-interior": { "$ref": "#/$defs/u64" },
        "static-executable-unassigned": { "$ref": "#/$defs/u64" },
        "authenticated-program-non-executable": { "$ref": "#/$defs/u64" },
        "runtime-only": { "$ref": "#/$defs/u64" }
      }
    }
  }
}
