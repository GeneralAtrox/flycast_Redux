{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flycast-redux.invalid/schemas/flycast-research-memory-ranges-manifest-v1.schema.json",
  "title": "Flycast Research Memory Ranges Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "manifest_id",
    "address_space",
    "bindings",
    "trigger",
    "ranges",
    "limits",
    "acceptance"
  ],
  "properties": {
    "schema": { "const": "flycast-research-memory-ranges-manifest" },
    "schema_version": { "const": 1 },
    "manifest_id": { "$ref": "#/$defs/id" },
    "address_space": { "const": "flycast-sh4-virtual" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable_sha256",
        "static_analysis_id",
        "static_analysis_sha256",
        "hook_manifest_id",
        "hook_manifest_sha256"
      ],
      "properties": {
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "static_analysis_id": { "$ref": "#/$defs/id" },
        "static_analysis_sha256": { "$ref": "#/$defs/sha256" },
        "hook_manifest_id": { "$ref": "#/$defs/id" },
        "hook_manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start_address", "end_address_exclusive"],
      "properties": {
        "kind": { "const": "guest-pc-enters-range" },
        "start_address": { "$ref": "#/$defs/address" },
        "end_address_exclusive": { "$ref": "#/$defs/address" }
      }
    },
    "ranges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["range_id", "address", "length", "expected_sha256"],
        "properties": {
          "range_id": { "$ref": "#/$defs/id" },
          "address": { "$ref": "#/$defs/address" },
          "length": { "type": "integer", "minimum": 1, "maximum": 16777216 },
          "expected_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_total_bytes"],
      "properties": {
        "maximum_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_consistency",
        "expected_trigger_count",
        "expected_event_count",
        "zero_dropped_events",
        "natural_exit"
      ],
      "properties": {
        "snapshot_consistency": { "const": "single-interpreter-boundary" },
        "expected_trigger_count": { "const": 1 },
        "expected_event_count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "zero_dropped_events": { "const": true },
        "natural_exit": { "const": true }
      }
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{8}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
