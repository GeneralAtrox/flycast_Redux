{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flycast-redux.invalid/schemas/flycast-research-sh4-events-manifest-v1.schema.json",
  "title": "Flycast Research SH-4 Events Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "manifest_id",
    "address_space",
    "bindings",
    "hooks",
    "watch_ranges",
    "limits",
    "acceptance"
  ],
  "properties": {
    "schema": { "const": "flycast-research-sh4-events-manifest" },
    "schema_version": { "const": 1 },
    "manifest_id": { "$ref": "#/$defs/id" },
    "address_space": { "const": "flycast-sh4-virtual" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable_sha256",
        "static_analysis_id",
        "static_analysis_sha256",
        "hook_manifest_id",
        "hook_manifest_sha256"
      ],
      "properties": {
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "static_analysis_id": { "$ref": "#/$defs/id" },
        "static_analysis_sha256": { "$ref": "#/$defs/sha256" },
        "hook_manifest_id": { "$ref": "#/$defs/id" },
        "hook_manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "hooks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hook_id", "entry_pc", "end_address_exclusive", "snapshots"],
        "properties": {
          "hook_id": { "$ref": "#/$defs/id" },
          "entry_pc": { "$ref": "#/$defs/address" },
          "end_address_exclusive": { "$ref": "#/$defs/address" },
          "snapshots": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["snapshot_id", "phase", "source", "length", "required"],
              "properties": {
                "snapshot_id": { "$ref": "#/$defs/id" },
                "phase": { "enum": ["call", "return"] },
                "source": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "address"],
                      "properties": {
                        "kind": { "const": "absolute" },
                        "address": { "$ref": "#/$defs/address" }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "register_index", "offset"],
                      "properties": {
                        "kind": { "const": "register-relative" },
                        "register_index": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 15
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": -2147483648,
                          "maximum": 2147483647
                        }
                      }
                    }
                  ]
                },
                "length": { "type": "integer", "minimum": 1, "maximum": 4096 },
                "required": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "watch_ranges": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["watch_id", "address", "length", "access"],
        "properties": {
          "watch_id": { "$ref": "#/$defs/id" },
          "address": { "$ref": "#/$defs/address" },
          "length": { "type": "integer", "minimum": 1, "maximum": 16777216 },
          "access": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": { "enum": ["read", "write"] }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_events",
        "maximum_snapshot_bytes_per_event",
        "maximum_total_snapshot_bytes",
        "maximum_open_invocations"
      ],
      "properties": {
        "maximum_events": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "maximum_snapshot_bytes_per_event": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "maximum_total_snapshot_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "maximum_open_invocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "minimum_call_events",
        "minimum_watch_events",
        "require_balanced_calls",
        "zero_dropped_events",
        "natural_exit"
      ],
      "properties": {
        "backend": { "const": "interpreter" },
        "minimum_call_events": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "minimum_watch_events": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "require_balanced_calls": { "const": true },
        "zero_dropped_events": { "const": true },
        "natural_exit": { "const": true }
      }
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{8}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
