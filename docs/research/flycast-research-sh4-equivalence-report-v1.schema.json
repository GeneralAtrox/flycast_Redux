{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flycast-research-sh4-equivalence-report-v1.schema.json",
  "title": "Flycast SH-4 equivalence report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "job_id", "status", "job", "emulator",
    "replay", "manifest_set", "interpreter", "dynarec", "comparator",
    "matched_event_count", "first_divergence"
  ],
  "properties": {
    "schema": { "const": "flycast-research-sh4-equivalence-report" },
    "schema_version": { "const": 1 },
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": { "enum": ["equivalent", "divergent"] },
    "job": { "$ref": "#/$defs/digest" },
    "emulator": {
      "type": "object", "additionalProperties": false,
      "required": ["git_commit", "file"],
      "properties": {
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "file": { "$ref": "#/$defs/blob" }
      }
    },
    "replay": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "maple_identity_sha256"],
      "properties": {
        "file": { "$ref": "#/$defs/blob" },
        "maple_identity_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "manifest_set": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "manifest_count"],
      "properties": {
        "file": { "$ref": "#/$defs/blob" },
        "manifest_count": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "interpreter": { "$ref": "#/$defs/backend" },
    "dynarec": { "$ref": "#/$defs/backend" },
    "comparator": {
      "type": "object", "additionalProperties": false,
      "required": ["executable"],
      "properties": { "executable": { "$ref": "#/$defs/blob" } }
    },
    "matched_event_count": { "type": "integer", "minimum": 0 },
    "first_divergence": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["ordinal", "field", "interpreter_value", "dynarec_value"],
          "properties": {
            "ordinal": { "type": "integer", "minimum": 0 },
            "field": { "type": "string", "minLength": 1 },
            "interpreter_value": { "type": "string" },
            "dynarec_value": { "type": "string" }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "equivalent" } } },
      "then": { "properties": { "first_divergence": { "type": "null" } } },
      "else": { "properties": { "first_divergence": { "type": "object" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": {
      "type": "object", "additionalProperties": false,
      "required": ["size", "sha256"],
      "properties": {
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "blob": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": [
        "file", "event_count", "payload_bytes", "payload_sha256",
        "start_tick", "end_tick", "dropped_events"
      ],
      "properties": {
        "file": { "$ref": "#/$defs/blob" },
        "event_count": { "type": "integer", "minimum": 1 },
        "payload_bytes": { "type": "integer", "minimum": 1 },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "start_tick": { "type": "integer", "minimum": 0 },
        "end_tick": { "type": "integer", "minimum": 0 },
        "dropped_events": { "const": 0 }
      }
    },
    "backend": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "identity_sha256", "configuration_sha256", "trace"],
      "properties": {
        "identity": { "$ref": "#/$defs/blob" },
        "identity_sha256": { "$ref": "#/$defs/sha256" },
        "configuration_sha256": { "$ref": "#/$defs/sha256" },
        "trace": { "$ref": "#/$defs/trace" }
      }
    }
  }
}
